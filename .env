# DocuGoSync environment configuration
# Copy to .env and fill in your values.

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=DocuGoSync
DEBUG=false
SECRET_KEY=change-me-in-production

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, MVP)
DATABASE_URL=sqlite+aiosqlite:///./docugosync.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/docugosync

# ── GitHub ───────────────────────────────────────────────────────────────────
# Personal access token (read-only for analysis, write for PR creation)
GITHUB_TOKEN=

# Webhook secret (set this in your GitHub webhook settings)
GITHUB_WEBHOOK_SECRET=http://localhost:5173/api/github/webhook

# GitHub App credentials (Phase 3)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── AI Provider (optional) ────────────────────────────────────────────────────
# Options: none | groq | openai | ollama
# The system works fully without AI — it augments correction quality only.
AI_PROVIDER=none

# Groq (free tier, recommended)
GROQ_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Detection settings ────────────────────────────────────────────────────────
MIN_CONFIDENCE_TO_REPORT=0.4
AUTO_APPLY_MIN_CONFIDENCE=0.9

# ── Auto-tracking ─────────────────────────────────────────────────────────────
# Set GITHUB_TOKEN + POLLING_ENABLED=true to automatically check for new commits.
# No public URL required — the backend polls GitHub directly.
POLLING_ENABLED=true
POLLING_INTERVAL_SECONDS=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
